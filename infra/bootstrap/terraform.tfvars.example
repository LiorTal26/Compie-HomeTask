# ==============================================================================
# Compie Home Task - Bootstrap Environment Configuration Variables
# ==============================================================================
# Usage:
#   1. Copy this file to terraform.tfvars:
#      Copy-Item terraform.tfvars.example terraform.tfvars
#   2. Replace github_subject with your GitHub Actions OIDC subject.
#   3. Run: terraform apply
# ==============================================================================

# Target AWS region for deployment
aws_region = "il-central-1"

# Project naming prefix used across all resources and tags
project = "compie"

# Exact GitHub Actions OIDC subject claim for repository and main branch.
# Format: repo:<GitHubOwner>/<RepoName>:ref:refs/heads/main
# IMPORTANT: Must be restricted strictly to 'main' branch without wildcards.
github_subject = "repo:LiorTal26/Compie-HomeTask:ref:refs/heads/main"

# Optional: ARN of an existing GitHub OIDC provider in this AWS account.
# Leave empty ("") if you want Terraform to create the OIDC provider automatically.
existing_oidc_provider_arn = ""
