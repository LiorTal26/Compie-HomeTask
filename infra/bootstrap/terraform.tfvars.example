aws_region = "il-central-1"
project    = "compie"

# Use the exact subject shown by your repository. This project uses the ID-based form.
github_subject = "repo:YOUR_USER@OWNER_ID/YOUR_REPO@REPOSITORY_ID:ref:refs/heads/main"
# existing_oidc_provider_arn = "arn:aws:iam::ACCOUNT:oidc-provider/token.actions.githubusercontent.com"

